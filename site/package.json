{
  "name": "nomadprogrammer-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/next-cli.cjs dev",
    "build": "node scripts/next-cli.cjs build",
    "start": "node scripts/next-cli.cjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --check \"src/**/*.{ts,tsx,css,md}\" \"content/**/*.mdx\" \"scripts/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"content/**/*.mdx\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.12",
    "next": "15.5.27",
    "next-mdx-remote": "^5.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "fast-glob": "^3.3.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "unist-util-visit": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
